# =============================================================================
# Configuration - Variables d'environnement
# =============================================================================
# Copiez ce fichier vers .env et remplissez les valeurs
# NE PAS COMMITTER .env dans le depot Git!
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================

# Clé API Anthropic Claude - OBLIGATOIRE pour Phase 1+
# Obtenez votre clé sur: https://console.anthropic.com/
ARCHI_CLAUDE_API_KEY=sk-ant-api03-votre-cle-api-ici

# Modèle Claude à utiliser (optionnel, defaut: claude-sonnet-4-5-20250514)
# ARCHI_CLAUDE_MODEL=claude-sonnet-4-5-20250514

# Nombre maximum de tokens pour les responses (optionnel, defaut: 4096)
# ARCHI_CLAUDE_MAX_TOKENS=4096

# =============================================================================
# Tesseract Configuration
# =============================================================================

# Langue Tesseract (optionnel, defaut: auto)
# Options: auto, fra, eng, fra+eng
# ARCHI_TESSERACT_LANG=auto

# =============================================================================
# Seuils de Configuration
# =============================================================================

# Confiance minimale pour les extractions (0.0-1.0, defaut: 0.8)
# ARCHI_MIN_CONFIDENCE=0.8

# Nombre minimum d'echantillons valides pour entrainement ML (defaut: 300)
# ARCHI_MIN_VALIDATED_SAMPLES=300

# Seuil de confiance pour passer en mode ML (0.0-1.0, defaut: 0.85)
# ARCHI_ML_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# Chemins Personnalises (Optionnel)
# =============================================================================

# Repertoire temporaire personalise
# ARCHI_TEMP_DIR=/tmp/archiextract

# Repertoire de debug
# ARCHI_DEBUG_DIR=./debug_output

# Base de donnees d'entrainement
# ARCHI_TRAINING_DB_PATH=./training_data.db

# Images d'entrainement
# ARCHI_TRAINING_IMAGES_DIR=./training_images

# Modeles ML
# ARCHI_ML_MODEL_DIR=./ml_models
