[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-k-z]

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

